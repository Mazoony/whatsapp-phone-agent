# ==========================================
# WhatsApp AI Agent Configuration
# ==========================================

# 1. Gemini API Key (Get a free API key at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Identity & Business Persona
OWNER_NAME=مستر مازن
BUSINESS_NAME=eShool / English School
BOT_ROLE=Executive Assistant

# 3. Anti-Ban & Humanization Timers
# Waits this many seconds after a client's last message to collect multiple rapid texts before replying
DEBOUNCE_SECONDS=6
# Simulates WhatsApp "typing..." state for this many milliseconds
TYPING_DELAY_MS=3000

# 4. Filters & Privacy
# "all" to reply to all 1-on-1 chats, or comma-separated numbers (e.g., 234801234567,14155552671)
ALLOWED_NUMBERS=all

# Comma-separated phone numbers to NEVER reply to (e.g. family, personal friends, bank alerts)
BLOCKED_NUMBERS=

# Automatically ignore all WhatsApp Groups (true recommended to avoid spam)
IGNORE_GROUPS=true

# 5. Permanent Chat Memory
# Any contact whose name contains "Es" automatically gets permanent chat history.
# You can also add specific numbers here:
ES_CONTACT_NUMBERS=

# 6. Personalized student follow-ups
# The first campaign targets up to 700 eligible Es contacts with saved chat history.
# The same cohort is checked again 72 hours after a campaign completes.
# Students can opt out by replying "إيقاف", "stop", or "unsubscribe".
FOLLOWUPS_ENABLED=true
FOLLOWUP_MAX_CONTACTS=700
FOLLOWUP_INTERVAL_HOURS=72
# Pause between outbound messages to avoid sending a large burst.
FOLLOWUP_SEND_DELAY_SECONDS=30
# Allow WhatsApp history/contact sync to finish before the first campaign.
FOLLOWUP_START_DELAY_SECONDS=60
